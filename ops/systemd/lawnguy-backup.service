[Unit]
Description=The Lawn Guy Bradford — nightly mongodump
After=mongod.service
Wants=mongod.service

[Service]
Type=oneshot
User=lawnguy
Group=lawnguy
ExecStart=/srv/lawnguy/ops/scripts/backup.sh
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
