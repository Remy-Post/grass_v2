[Unit]
Description=The Lawn Guy Bradford — nightly mongodump
After=mongod.service
Wants=mongod.service

[Service]
Type=oneshot
User=lawnguy
Group=lawnguy
# Offsite backup target — comment out the Environment line to disable
# Spaces upload (local nightly archive in /var/backups/lawnguy is unaffected).
Environment=DO_SPACES_BUCKET=tlg-backups
ExecStart=/srv/lawnguy/ops/scripts/backup.sh
StandardOutput=journal
StandardError=journal
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
