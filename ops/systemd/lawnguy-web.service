[Unit]
Description=The Lawn Guy Bradford — Next.js web
After=network.target lawnguy-api.service
Wants=lawnguy-api.service

[Service]
Type=simple
User=lawnguy
Group=lawnguy
WorkingDirectory=/srv/lawnguy/apps/web
EnvironmentFile=/srv/lawnguy/apps/web/.env.local
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lawnguy/apps/web/.next /var/log/lawnguy

# Resource limits — generous on 24GB Ampere
LimitNOFILE=4096
MemoryMax=1G

[Install]
WantedBy=multi-user.target
