# Public site URL (used for SEO metadataBase, canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API base URL — exposed to the browser so client components (form + chat)
# can hit it directly in dev. In production, leave it empty so requests are
# same-origin via Nginx (`/api/*` is proxied to apps/api on the OCI VM).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Server-side only API base (currently unused by Phase 4; Phase 5 will use
# this for server components that fetch from the api during SSR).
API_BASE_URL=http://localhost:3001

# Admin panel auth — must match apps/api ADMIN_TOKEN in production.
# Local dev placeholder only.
ADMIN_TOKEN=dev-admin-token-change-me
