NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────
# Local: install MongoDB Community 7, default connection works.
# Remote: paste your Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/lawnguy

# ─── Admin (Phase 5) ────────────────────────────────────────────
# Long random string. Rotate via password manager. Never commit.
ADMIN_TOKEN=replace-with-strong-random-string-min-32-chars

# ─── AI chat ────────────────────────────────────────────────────
# Both optional. Without them, the chat falls back to scripted-only mode.
# OpenAI is tried first, Gemini is the fallback if OpenAI errors.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Email (lead notifications) ─────────────────────────────────
# Use a Gmail app password (not your account password):
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=remy.post.06@gmail.com
SMTP_PASS=
OWNER_EMAIL=remy.post.06@gmail.com

# ─── CTA handoff destinations ───────────────────────────────────
# When the chat helper finishes, the visitor is handed off here.
# Once Remy has a public business number, set OWNER_SMS_HREF to sms:+1...
OWNER_SMS_HREF=

# ─── Rate limiting ──────────────────────────────────────────────
# Per-IP daily cap for /api/public/chat (protects against OpenAI bill blowup).
CHAT_DAILY_LIMIT=50
LEAD_HOURLY_LIMIT=20
